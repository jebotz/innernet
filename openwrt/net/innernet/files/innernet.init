#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1

# Runs one `innernet up --daemon` instance per enabled 'network' section in
# /etc/config/innernet. Each instance handles exactly one innernet network
# (the same "one systemd unit per network" model as innernet@.service on
# systemd distros), so a failure or restart of one network doesn't touch
# the others.
innernet_instance() {
	local cfg="$1"
	local enabled name interval write_hosts hosts_path host_suffix nat_traversal

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get name "$cfg" name "$cfg"
	config_get interval "$cfg" interval "$innernet_interval"
	config_get_bool write_hosts "$cfg" write_hosts "$innernet_write_hosts"
	config_get hosts_path "$cfg" hosts_path "$innernet_hosts_path"
	config_get host_suffix "$cfg" host_suffix "$innernet_host_suffix"
	config_get_bool nat_traversal "$cfg" nat_traversal "$innernet_nat_traversal"

	[ -f "$innernet_config_dir/$name.conf" ] || {
		echo "innernet: no config for network '$name' in $innernet_config_dir (run 'innernet install' first), skipping" >&2
		return 0
	}

	procd_open_instance "innernet.$name"
	procd_set_param command /usr/bin/innernet \
		--config-dir "$innernet_config_dir" \
		--data-dir "$innernet_data_dir" \
		up --daemon --interval "$interval"

	if [ "$write_hosts" = "1" ]; then
		[ -n "$hosts_path" ] && procd_append_param command --hosts-path "$hosts_path"
	else
		procd_append_param command --no-write-hosts
	fi
	[ -n "$host_suffix" ] && procd_append_param command --host-suffix "$host_suffix"
	[ "$nat_traversal" = "1" ] || procd_append_param command --no-nat-traversal

	procd_append_param command "$name"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local innernet_interval innernet_write_hosts innernet_hosts_path
	local innernet_host_suffix innernet_nat_traversal
	local innernet_config_dir innernet_data_dir

	config_load innernet

	config_get innernet_interval global interval 60
	config_get_bool innernet_write_hosts global write_hosts 1
	config_get innernet_hosts_path global hosts_path /tmp/hosts/innernet
	config_get innernet_host_suffix global host_suffix
	config_get_bool innernet_nat_traversal global nat_traversal 1
	config_get innernet_config_dir global config_dir /etc/innernet
	config_get innernet_data_dir global data_dir /var/lib/innernet

	[ "$innernet_write_hosts" = "1" ] && [ -n "$innernet_hosts_path" ] && \
		mkdir -p "$(dirname "$innernet_hosts_path")"

	config_foreach innernet_instance network
}

service_triggers() {
	procd_add_reload_trigger innernet
}
