config global 'global'
	# Default fetch interval in seconds for every network below, unless
	# overridden per-network.
	option interval '60'

	# Write resolvable PEER.innernet-style entries somewhere dnsmasq can
	# pick them up. Defaults to a tmpfs path rather than /etc/hosts itself,
	# since peer endpoints (and therefore this file) can churn often and
	# /etc/hosts lives on flash.
	#
	# To have dnsmasq actually serve these names, add the path as an
	# addnhosts entry once:
	#   uci add_list dhcp.@dnsmasq[0].addnhosts='/tmp/hosts/innernet'
	#   uci commit dhcp
	#   /etc/init.d/dnsmasq restart
	option write_hosts '1'
	option hosts_path '/tmp/hosts/innernet'

	option nat_traversal '1'

	option config_dir '/etc/innernet'
	option data_dir '/var/lib/innernet'

# Add one 'network' section per network you've joined with
# `innernet install <invite-file>`. The 'name' option (or the section name,
# if 'name' is omitted) must match the interface name shown by
# `innernet show`, e.g.:
#
# config network 'home'
#	option name 'home'
#	option enabled '1'
#	# option interval '30'
#	# option write_hosts '0'
#	# option nat_traversal '0'
